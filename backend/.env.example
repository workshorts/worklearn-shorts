# Copy this file to backend/.env and fill in local values.
# Existing process environment variables take precedence over this file.
PORT=3000

# Relative storage paths are interpreted from backend by the storage modules.
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
ALLOWED_ORIGIN=http://localhost:5173

# Set local secrets before using authentication or creating an administrator.
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
