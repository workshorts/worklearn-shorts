# Copy this file to backend/.env and fill in local values.
# Existing process environment variables take precedence over this file.
PORT=3000

# Relative storage paths are interpreted from backend by the storage modules.
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
ALLOWED_ORIGIN=http://localhost:5173

# Set local secrets before using authentication or creating an administrator.
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Admin login options (defaults are shown). 8 hours; set 720 for 30 days.
ADMIN_SESSION_HOURS=8
# Set true only when the site is served over https.
COOKIE_SECURE=false
# Block login for LOGIN_WINDOW_MINUTES after LOGIN_MAX_FAILS failed attempts.
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MINUTES=15
