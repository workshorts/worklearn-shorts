{
  "name": "worklearn-shorts-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node db/init.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"test/**/*.test.js\"",
    "test:db": "node --test --test-reporter=spec --test-concurrency=1 \"test/db/*.test.js\"",
    "admin:create": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "file-type": "22.2.0"
  }
}
